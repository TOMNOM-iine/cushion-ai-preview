{
  "name": "cushion-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "wasm:build": "sh scripts/build-wasm.sh",
    "verify:wasm": "node scripts/verify-wasm.mjs",
    "example": "vitest run tests/examples/embedded-chat.test.ts",
    "test": "vitest run",
    "check": "npm run wasm:build && npm run build && npm test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
